{
  // Step through align_srt.py on a film selected in lab/pick_films.py.
  // lab/debug_film.py asks in the terminal which selected film to debug
  // (`p` opens the pick_films window to select others) and which approach
  // (0: WhisperX transcript, A: --force-align), then passes the DVC
  // align_0 or align_A stage's arguments for it; the outputs go to
  // lab/debug/<film>/0/ or lab/debug/<film>/A/ (git-ignored) so DVC's
  // outputs stay as DVC wrote them. After one `dvc repro` of the film, every audio question is
  // answered from its cache, so the video and the GPU model are never
  // loaded.
  //
  // The first configuration (F5's default) also sets SUBRETIME_STOPS: the
  // run pauses inside the steps and on the lines that lab/stops.yaml lists
  // (see dev_stops.py); its cue numbers are the chosen film's. The second
  // runs without pausing.
  "version": "0.2.0",
  "configurations": [
    {
      "name": "step through film (stops.yaml)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lab/debug_film.py",
      "cwd": "${workspaceFolder}/lab",
      "console": "integratedTerminal",
      "justMyCode": true,
      "env": {
        "SUBRETIME_STOPS": "${workspaceFolder}/lab/stops.yaml"
      }
    },
    {
      "name": "align film (no stops)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/lab/debug_film.py",
      "cwd": "${workspaceFolder}/lab",
      "console": "integratedTerminal",
      "justMyCode": true
    }
  ]
}
